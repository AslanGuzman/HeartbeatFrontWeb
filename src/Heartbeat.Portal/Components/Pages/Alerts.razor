@page "/alerts"
@using System.Net
@using System.Text.Json
@inject MissionControlClient Client
@inject MissionControlSession Session
@inject AlertCounterState AlertCounter

<PageTitle>Heartbeat | Alerts</PageTitle>

<RequirePermission Permission="@Permissions.AlertsView">
    <ChildContent>
        <section class="alerts-page" aria-labelledby="alerts-title">
            <header class="alerts-heading">
                <div>
                    <h1 id="alerts-title">Alert center</h1>
                    <p>Critical readings reported by the crew.</p>
                </div>
                @if (_alerts is not null && !_loading)
                {
                    <span class="alerts-total">@_alerts.Total alerts</span>
                }
            </header>

            <nav class="alerts-tabs" aria-label="Filter alerts">
                <button type="button"
                        class="@TabClass("all")"
                        aria-pressed="@(_state == "all")"
                        @onclick="ShowAllAsync">
                    All
                </button>
                <button type="button"
                        class="@TabClass("open")"
                        aria-pressed="@(_state == "open")"
                        @onclick="ShowOpenAsync">
                    Open
                </button>
                <button type="button"
                        class="@TabClass("acknowledged")"
                        aria-pressed="@(_state == "acknowledged")"
                        @onclick="ShowAcknowledgedAsync">
                    Reconocidas
                </button>
            </nav>

            @if (_loading)
            {
                <div class="alerts-state" role="status" aria-busy="true">
                    <span class="session-spinner" aria-hidden="true"></span>
                    <span>Loading alerts…</span>
                </div>
            }
            else if (_forbidden)
            {
                <div class="alerts-state" role="alert">
                    <h2>You don’t have permission to view alerts</h2>
                    <p>Your account does not have the required permission.</p>
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="alerts-state" role="alert">
                    <h2>Could not load alerts</h2>
                    <p>@_loadError</p>
                    <button class="alerts-button" type="button" @onclick="LoadAlertsAsync">Retry</button>
                </div>
            }
            else if (_alerts is null || _alerts.Items.Count == 0)
            {
                <div class="alerts-state alerts-empty">
                    <h2>@EmptyTitle</h2>
                    <p>@EmptyMessage</p>
                </div>
            }
            else
            {
                <div class="alerts-list">
                    @foreach (var alert in _alerts.Items)
                    {
                        var acknowledged = alert.AcknowledgedAt is not null;
                        <article @key="alert.Id"
                                 class="alert-card @(acknowledged ? "alert-card--acknowledged" : "alert-card--open")">
                            <header class="alert-card-heading">
                                <div>
                                    <h2>@IndicatorSummary(alert.Indicators)</h2>
                                    <p class="alert-astronaut">@alert.AstronautName</p>
                                </div>
                                <span class="alert-severity">Critical</span>
                            </header>

                            <dl class="alert-details">
                                <div>
                                    <dt>Alert date</dt>
                                    <dd>@FormatTimestamp(alert.CreatedAt)</dd>
                                </div>
                                <div>
                                    <dt>Indicadores</dt>
                                    <dd class="alert-indicators">
                                        @foreach (var indicator in alert.Indicators)
                                        {
                                            <span @key="indicator">@IndicatorName(indicator)</span>
                                        }
                                    </dd>
                                </div>
                            </dl>

                            @if (acknowledged)
                            {
                                <div class="alert-acknowledgement">
                                    <strong>Reconocida por @(alert.AcknowledgedBy ?? "Username no disponible")</strong>
                                    <span>@FormatTimestamp(alert.AcknowledgedAt!.Value)</span>
                                    @if (!string.IsNullOrWhiteSpace(alert.AcknowledgeNote))
                                    {
                                        <p>@alert.AcknowledgeNote</p>
                                    }
                                </div>
                            }
                            else if (Session.HasPermission(Permissions.AlertsAcknowledge))
                            {
                                @if (_acknowledgingAlertId == alert.Id)
                                {
                                    <form class="acknowledge-form"
                                          @onsubmit="() => AcknowledgeAsync(alert.Id)"
                                          @onsubmit:preventDefault>
                                        <label for="@($"ack-note-{alert.Id:N}")">Nota de reconocimiento</label>
                                        <textarea id="@($"ack-note-{alert.Id:N}")"
                                                  @bind="_acknowledgeNote"
                                                  maxlength="500"
                                                  required
                                                  rows="3"></textarea>
                                        <span class="acknowledge-hint">Required, up to 500 characters.</span>
                                        @if (_acknowledgeError is not null)
                                        {
                                            <p class="acknowledge-error" role="alert">@_acknowledgeError</p>
                                        }
                                        <div class="acknowledge-actions">
                                            <button class="alerts-button"
                                                    type="submit"
                                                    disabled="@(_savingAcknowledgement || string.IsNullOrWhiteSpace(_acknowledgeNote))">
                                                @(_savingAcknowledgement ? "Saving…" : "Confirmar reconocimiento")
                                            </button>
                                            <button class="alerts-button alerts-button--secondary"
                                                    type="button"
                                                    disabled="@_savingAcknowledgement"
                                                    @onclick="CancelAcknowledge">
                                                Cancel
                                            </button>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <button class="alerts-action"
                                            type="button"
                                            @onclick="() => BeginAcknowledge(alert.Id)">
                                        Acknowledge alert
                                    </button>
                                }
                            }
                        </article>
                    }
                </div>

                <nav class="alerts-pagination" aria-label="Alert pages">
                    <span>Page @_page de @PageCount</span>
                    <div>
                        <button class="alerts-button alerts-button--secondary"
                                type="button"
                                disabled="@(_page <= 1 || _loading)"
                                @onclick="PreviousPageAsync">
                            Previous
                        </button>
                        <button class="alerts-button alerts-button--secondary"
                                type="button"
                                disabled="@(_page >= PageCount || _loading)"
                                @onclick="NextPageAsync">
                            Next
                        </button>
                    </div>
                </nav>
            }
        </section>
    </ChildContent>
    <NotAuthorized>
        <section class="alerts-state" role="alert">
            <h1>You don’t have permission to view alerts</h1>
            <p>Your account does not have the required permission.</p>
        </section>
    </NotAuthorized>
</RequirePermission>

@code {
    private const int PageSize = 20;
    private string _state = "all";
    private int _page = 1;
    private Paged<AlertDto>? _alerts;
    private bool _loading = true;
    private bool _forbidden;
    private string? _loadError;
    private Guid? _acknowledgingAlertId;
    private string _acknowledgeNote = string.Empty;
    private string? _acknowledgeError;
    private bool _savingAcknowledgement;

    private int PageCount =>
        _alerts is null ? 1 : Math.Max(1, (int)Math.Ceiling((double)_alerts.Total / PageSize));

    private string EmptyTitle => _state switch
    {
        "open" => "No open alerts",
        "acknowledged" => "No acknowledged alerts",
        _ => "No alerts found"
    };

    private string EmptyMessage => _state == "open"
        ? "Open crew alerts will appear here."
        : "Try another filter to find alerts.";

    protected override async Task OnInitializedAsync()
    {
        if (Session.HasPermission(Permissions.AlertsView))
        {
            await LoadAlertsAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadAlertsAsync()
    {
        if (!Session.HasPermission(Permissions.AlertsView))
        {
            _loading = false;
            return;
        }

        _loading = true;
        _forbidden = false;
        _loadError = null;

        try
        {
            _alerts = await Client.GetAlertsAsync(_state, _page, PageSize);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or
                JsonException or
                InvalidDataException or
                TaskCanceledException)
        {
            _loadError = "Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ShowAllAsync() => ChangeStateAsync("all");

    private Task ShowOpenAsync() => ChangeStateAsync("open");

    private Task ShowAcknowledgedAsync() => ChangeStateAsync("acknowledged");

    private async Task ChangeStateAsync(string state)
    {
        _state = state;
        _page = 1;
        CancelAcknowledge();
        await LoadAlertsAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAlertsAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (_page < PageCount)
        {
            _page++;
            await LoadAlertsAsync();
        }
    }

    private void BeginAcknowledge(Guid alertId)
    {
        _acknowledgingAlertId = alertId;
        _acknowledgeNote = string.Empty;
        _acknowledgeError = null;
    }

    private void CancelAcknowledge()
    {
        _acknowledgingAlertId = null;
        _acknowledgeNote = string.Empty;
        _acknowledgeError = null;
    }

    private async Task AcknowledgeAsync(Guid alertId)
    {
        if (!Session.HasPermission(Permissions.AlertsAcknowledge))
        {
            return;
        }

        var note = _acknowledgeNote.Trim();
        if (note.Length is 0 or > 500)
        {
            _acknowledgeError = "Enter a note of up to 500 characters.";
            return;
        }

        _savingAcknowledgement = true;
        _acknowledgeError = null;

        try
        {
            await Client.AcknowledgeAlertAsync(alertId, note);
            CancelAcknowledge();
            await LoadAlertsAsync();
            await AlertCounter.RefreshAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _acknowledgeError = "Your account does not have permission to acknowledge alerts.";
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            _acknowledgeError = "This alert is no longer available. Refresh the list.";
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            _acknowledgeError = "This alert has already been acknowledged. Refresh the list.";
            await LoadAlertsAsync();
            await AlertCounter.RefreshAsync();
        }
        catch (Exception exception) when (
            exception is HttpRequestException or
                JsonException or
                InvalidDataException or
                TaskCanceledException)
        {
            _acknowledgeError = "Could not save the acknowledgement. Check your connection and try again.";
        }
        finally
        {
            _savingAcknowledgement = false;
        }
    }

    private string TabClass(string state) =>
        state == _state ? "alerts-tab alerts-tab--active" : "alerts-tab";

    private static string IndicatorSummary(IReadOnlyList<IndicatorType> indicators) =>
        string.Join(", ", indicators.Select(IndicatorName));

    private static string IndicatorName(IndicatorType indicator) => indicator switch
    {
        IndicatorType.BloodPressure => "Blood pressure",
        IndicatorType.HeartRate => "Heart rate",
        IndicatorType.BloodSugar => "Blood glucose",
        IndicatorType.BodyTemperature => "Body temperature",
        IndicatorType.Sleep => "Sleep",
        IndicatorType.Mood => "Mood",
        _ => indicator.ToString()
    };

    private static string FormatTimestamp(DateTimeOffset timestamp) =>
        timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
}
