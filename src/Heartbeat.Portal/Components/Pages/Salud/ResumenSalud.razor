@page "/salud"
@using System.Globalization
@using Heartbeat.Portal.Salud
@inject MissionControlClient Client
@inject MissionControlSession Session

<PageTitle>Heartbeat | Resumen de salud</PageTitle>

<RequirePermission Permission="@Permissions.CrewView">
  <RequirePermission Permission="@Permissions.VitalsView">
    <section class="salud-page" aria-labelledby="salud-title">
        <header class="salud-heading">
            <div>
                <h1 id="salud-title">Resumen de salud</h1>
                <p>@_syncText</p>
            </div>
            <button class="salud-button" type="button" @onclick="LoadAsync" disabled="@_loading">Actualizar</button>
        </header>

        @if (_loadingCrew)
        {
            <div class="salud-state" role="status">Cargando astronautas…</div>
        }
        else if (_crewError is not null)
        {
            <p class="salud-error" role="alert">@_crewError</p>
        }
        else if (_crew is null || _crew.Length == 0)
        {
            <p class="salud-empty">No hay astronautas disponibles.</p>
        }
        else
        {
        <label class="salud-selector">
            <span>Astronauta</span>
            <select @bind="_selectedAstronautId" @bind:after="LoadAsync" disabled="@_loading">
                @foreach (var astronaut in _crew)
                {
                    <option value="@astronaut.AstronautId">@AstronautLabel(astronaut)</option>
                }
            </select>
        </label>

        @if (_loading)
        {
            <div class="salud-state" role="status" aria-busy="true">
                <span class="session-spinner" aria-hidden="true"></span>
                <span>Cargando datos de Samsung Health…</span>
            </div>
        }
        else
        {
            @foreach (var error in _errors)
            {
                <p class="salud-error" role="alert">@error</p>
            }

            <h2>Últimos valores</h2>
            <div class="salud-cards">
                @foreach (var card in Cards())
                {
                    <article class="salud-card">
                        <h3>@card.Title</h3>
                        <p class="salud-card-value">@card.Value</p>
                        <p class="salud-card-meta">@card.Measured</p>
                    </article>
                }
            </div>

            <h2>Actividad</h2>
            <p class="salud-steps">Pasos de hoy: <strong>@StepsToday()</strong></p>
            @if (_activity is { Count: > 0 })
            {
                <div class="salud-table-wrap">
                    <table class="salud-table">
                        <thead>
                            <tr><th>Fecha</th><th>Pasos</th><th>Distancia</th><th>Calorías activas</th><th>Minutos activos</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var day in _activity.OrderByDescending(d => d.LocalDate).Take(7))
                            {
                                <tr>
                                    <td>@day.LocalDate.ToString("ddd dd/MM", CultureInfo.CurrentCulture)</td>
                                    <td>@(day.Steps?.ToString("N0", CultureInfo.CurrentCulture) ?? "—")</td>
                                    <td>@(day.DistanceM is { } m ? $"{m / 1000:0.00} km" : "—")</td>
                                    <td>@(day.ActiveCaloriesKcal is { } kcal ? $"{kcal:0} kcal" : "—")</td>
                                    <td>@(day.ActiveMinutes is { } min ? $"{min} min" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="salud-empty">Sin datos de actividad en los últimos 7 días.</p>
            }

            <h2>Última noche</h2>
            @if (LastNight() is { } night)
            {
                <p class="salud-sleep">
                    <strong>@(night.DurationMin / 60) h @(night.DurationMin % 60) min</strong>
                    · @night.StartAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) → @night.EndAt.ToLocalTime().ToString("t", CultureInfo.CurrentCulture)
                </p>
                @if (night.StageMinutes is { } st)
                {
                    <p class="salud-stages">Despierto @st.Awake min · Ligero @st.Light min · Profundo @st.Deep min · REM @st.Rem min</p>
                }
            }
            else
            {
                <p class="salud-empty">Sin datos</p>
            }
        }
        }

        <p class="salud-disclaimer">Datos del reloj, no validados clínicamente</p>
    </section>
  </RequirePermission>
</RequirePermission>

@code {
    private const string NoData = "Sin datos";

    private bool _loading = true;
    private bool _loadingCrew = true;
    private readonly List<string> _errors = new();
    private CrewSummaryDto[]? _crew;
    private Guid _selectedAstronautId;
    private string? _crewError;
    private DailySummaryDto? _summary;
    private List<DailyActivityDto>? _activity;
    private List<SleepRecordDto>? _sleep;
    private string _syncText = "Última sincronización de Samsung Health: …";

    private sealed record Card(string Title, string Value, string Measured);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.HasPermission(Permissions.CrewView) ||
            !Session.HasPermission(Permissions.VitalsView))
        {
            _loadingCrew = false;
            _loading = false;
            return;
        }

        try
        {
            _crew = await Client.GetCrewAsync();
            if (_crew.Length > 0)
            {
                _selectedAstronautId = _crew[0].AstronautId;
                await LoadAsync();
            }
        }
        catch (Exception exception) when (
            exception is HttpRequestException or InvalidDataException or TaskCanceledException)
        {
            _crewError = "No se pudo cargar la tripulación.";
            _loading = false;
        }
        finally
        {
            _loadingCrew = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errors.Clear();

        var summaryTask = Client.GetSaludAsync<DailySummaryDto>(SaludPath("resumen"));
        var activityTask = Client.GetSaludAsync<List<DailyActivityDto>>(SaludPath("actividad"));
        var sleepTask = Client.GetSaludAsync<List<SleepRecordDto>>(SaludPath("sueno"));
        var statusTask = Client.GetSaludAsync<List<SyncStatusDto>>(SaludPath("estado"));
        await Task.WhenAll(summaryTask, activityTask, sleepTask, statusTask);

        _summary = summaryTask.Result.Data;
        _activity = activityTask.Result.Data;
        _sleep = sleepTask.Result.Data;
        _syncText = SyncText(statusTask.Result.Data);
        _errors.AddRange(new[] { summaryTask.Result.Error, activityTask.Result.Error, sleepTask.Result.Error, statusTask.Result.Error }
            .OfType<string>()
            .Distinct());
        _loading = false;
    }

    private string SaludPath(string resource) =>
        $"/api/salud/{resource}?astronautId={_selectedAstronautId:D}";

    private static string AstronautLabel(CrewSummaryDto astronaut) =>
        string.IsNullOrWhiteSpace(astronaut.CallSign)
            ? astronaut.DisplayName
            : $"{astronaut.DisplayName} ({astronaut.CallSign})";

    private IEnumerable<Card> Cards()
    {
        var latest = _summary?.Latest ?? new LatestValuesDto();
        yield return MakeCard("Frecuencia cardíaca", latest.HeartRate, v => $"{v.Value:0} {v.Unit ?? "lpm"}");
        yield return MakeCard("SpO₂", latest.Spo2, v => $"{v.Value:0} {v.Unit ?? "%"}");
        yield return MakeCard("Presión arterial", latest.BloodPressure,
            v => $"{v.Value:0}/{v.Value2?.ToString("0", CultureInfo.CurrentCulture) ?? "?"} {v.Unit ?? "mmHg"}");
        yield return MakeCard("Temperatura de piel", latest.SkinTemperature, v => $"{v.Value:0.0} {v.Unit ?? "°C"}");
        yield return MakeCard("Peso", latest.WeightKg, v => $"{v.Value:0.0} {v.Unit ?? "kg"}");
        yield return MakeCard("Energy Score", latest.EnergyScore, v => $"{v.Value:0}");
    }

    private static Card MakeCard(string title, LatestValueDto? value, Func<LatestValueDto, string> format) =>
        value is null
            ? new Card(title, NoData, " ")
            : new Card(title, format(value), $"Medido: {value.MeasuredAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)}");

    private string StepsToday()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        var steps = _summary?.Activity?.Steps ?? _activity?.FirstOrDefault(d => d.LocalDate == today)?.Steps;
        return steps?.ToString("N0", CultureInfo.CurrentCulture) ?? NoData;
    }

    private SleepRecordDto? LastNight() => _summary?.Sleep ?? _sleep?.OrderByDescending(n => n.EndAt).FirstOrDefault();

    private static string SyncText(List<SyncStatusDto>? status)
    {
        if (status is not { Count: > 0 })
        {
            return "Última sincronización de Samsung Health: sin datos";
        }

        var minutes = Math.Max(0, (int)(DateTimeOffset.Now - status.Max(s => s.LastSyncedAt)).TotalMinutes);
        return $"Última sincronización de Samsung Health: hace {minutes} min";
    }
}
