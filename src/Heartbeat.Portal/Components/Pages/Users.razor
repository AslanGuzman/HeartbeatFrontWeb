@page "/users"
@using System.Net
@using System.Text.Json
@using Heartbeat.Shared
@inject MissionControlClient Client
@inject MissionControlSession Session

<PageTitle>Heartbeat | User administration</PageTitle>

<RequirePermission Permission="@Permissions.UsersView">
    <ChildContent>
        <section class="users-page" aria-labelledby="users-title">
            <header class="users-heading">
                <div>
                    <h1 id="users-title">Users del portal</h1>
                    <p>Manage accounts and roles.</p>
                </div>
                <div>
                    @if (Session.HasPermission(Permissions.UsersManage))
                    {
                        <button class="users-button users-button--primary"
                                type="button"
                                @onclick="OpenCreateUserModal">Create user</button>
                    }
                </div>
            </header>

            @if (_loading)
            {
                <div class="users-state" role="status" aria-busy="true">
                    <span class="session-spinner" aria-hidden="true"></span>
                    <span>Loading users…</span>
                </div>
            }
            else if (_forbidden)
            {
                <div class="users-state" role="alert">
                    <h2>You don’t have permission to view users</h2>
                    <p>Your account does not have the required permission.</p>
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="users-state" role="alert">
                    <h2>Could not load users</h2>
                    <p>@_loadError</p>
                    <button class="users-button" type="button" @onclick="LoadUsersAsync">Retry</button>
                </div>
            }
            else if (_users is null || _users.Items.Count == 0)
            {
                <div class="users-state users-empty">
                    <h2>No users found</h2>
                    <p>Users will appear here.</p>
                </div>
            }
            else
            {
                <div class="users-list">
                    @foreach (var user in _users.Items)
                    {
                        <article @key="user.Id"
                                 class="user-card @(user.IsActive ? "" : "user-card--inactive")">
                            <header class="user-card-heading">
                                <div>
                                    <h2>@user.DisplayName</h2>
                                    <p class="user-username">@user.UserName</p>
                                </div>
                                <span class="user-status @(user.IsActive ? "user-status--active" : "user-status--inactive")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </header>

                            <dl class="user-details">
                                <div>
                                    <dt>Email</dt>
                                    <dd>@user.Email</dd>
                                </div>
                                <div>
                                    <dt>Rol</dt>
                                    <dd>@user.Role.Name</dd>
                                </div>
                                <div>
                                    <dt>Permissions</dt>
                                    <dd>
                                        @foreach (var perm in user.Permissions)
                                        {
                                            <span @key="perm" class="user-permission">@perm</span>
                                        }
                                    </dd>
                                </div>
                            </dl>

                            <div class="user-actions">
                                @if (Session.HasPermission(Permissions.UsersManage))
                                {
                                    <button class="users-action users-action--small"
                                            type="button"
                                            @onclick="() => OpenUpdateModal(user)">Edit</button>
                                    <button class="users-action users-action--small"
                                            type="button"
                                            @onclick="() => OpenSetRoleModal(user)">Change role</button>
                                    <button class="users-action users-action--small users-action--danger"
                                            type="button"
                                            disabled="@(_toggleUserId == user.Id)"
                                            @onclick="() => ToggleUserStatusAsync(user)">@(user.IsActive ? "Disable" : "Enable")</button>
                                }
                            </div>
                        </article>
                    }
                </div>

                <nav class="users-pagination" aria-label="User pages">
                    <span>Page @_page de @PageCount</span>
                    <div>
                        <button class="users-button users-button--secondary"
                                type="button"
                                disabled="@(_page <= 1 || _loading)"
                                @onclick="PreviousPageAsync">Previous</button>
                        <button class="users-button users-button--secondary"
                                type="button"
                                disabled="@(_page >= PageCount || _loading)"
                                @onclick="NextPageAsync">Next</button>
                    </div>
                </nav>
            }

            @if (_actionError is not null)
            {
                <p class="users-error" role="alert">@_actionError</p>
            }

            @if (_showCreateUserModal || _showUpdateModal || _showSetRoleModal)
            {
                <div class="users-overlay" @onclick="CloseModals">
                    <div class="users-modal"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="users-modal-title"
                         @onclick:stopPropagation="true">
                        @if (_showCreateUserModal)
                        {
                            <form class="users-form" @onsubmit="CreateUserAsync" @onsubmit:preventDefault>
                                <h2 id="users-modal-title">New user</h2>

                                <label>
                                    <span>Username</span>
                                    <input @bind="_newUserName"
                                           maxlength="50"
                                           required
                                           disabled="@_saving" />
                                </label>
                                <label>
                                    <span>Email</span>
                                    <input type="email"
                                           @bind="_newEmail"
                                           required
                                           disabled="@_saving" />
                                </label>
                                <label>
                                    <span>Display name</span>
                                    <input @bind="_newDisplayName"
                                           maxlength="100"
                                           required
                                           disabled="@_saving" />
                                </label>
                                <label>
                                    <span>Password</span>
                                    <input type="password"
                                           @bind="_newPassword"
                                           required
                                           disabled="@_saving" />
                                </label>
                                <label>
                                    <span>Rol</span>
                                    <select @bind="_newRoleId"
                                            required
                                            disabled="@(_saving || _roles.Count == 0)">
                                        <option value="@Guid.Empty">Select a role</option>
                                        @foreach (var role in _roles)
                                        {
                                            <option value="@role.Id">@role.Name</option>
                                        }
                                    </select>
                                </label>

                                @if (_rolesError is not null)
                                {
                                    <p class="users-error" role="alert">@_rolesError</p>
                                }
                                @if (_modalError is not null)
                                {
                                    <p class="users-error" role="alert">@_modalError</p>
                                }

                                <div class="users-form-actions">
                                    <button class="users-button users-button--primary"
                                            type="submit"
                                            disabled="@(_saving || _roles.Count == 0)">
                                        @(_saving ? "Saving…" : "Create user")
                                    </button>
                                    <button class="users-button"
                                            type="button"
                                            disabled="@_saving"
                                            @onclick="CloseModals">Cancel</button>
                                </div>
                            </form>
                        }
                        else if (_showUpdateModal)
                        {
                            <form class="users-form" @onsubmit="UpdateUserAsync" @onsubmit:preventDefault>
                                <h2 id="users-modal-title">Edit user</h2>
                                <p class="users-form-note">@_updateUserName</p>

                                <label>
                                    <span>Email</span>
                                    <input type="email"
                                           @bind="_updateEmail"
                                           required
                                           disabled="@_saving" />
                                </label>
                                <label>
                                    <span>Display name</span>
                                    <input @bind="_updateDisplayName"
                                           maxlength="100"
                                           required
                                           disabled="@_saving" />
                                </label>

                                @if (_modalError is not null)
                                {
                                    <p class="users-error" role="alert">@_modalError</p>
                                }

                                <div class="users-form-actions">
                                    <button class="users-button users-button--primary"
                                            type="submit"
                                            disabled="@_saving">
                                        @(_saving ? "Saving…" : "Save cambios")
                                    </button>
                                    <button class="users-button"
                                            type="button"
                                            disabled="@_saving"
                                            @onclick="CloseModals">Cancel</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <form class="users-form" @onsubmit="SetUserRoleAsync" @onsubmit:preventDefault>
                                <h2 id="users-modal-title">Change role</h2>
                                <p class="users-form-note">@_roleUserName</p>

                                <label>
                                    <span>Rol</span>
                                    <select @bind="_selectedRoleId"
                                            required
                                            disabled="@(_saving || _roles.Count == 0)">
                                        <option value="@Guid.Empty">Select a role</option>
                                        @foreach (var role in _roles)
                                        {
                                            <option value="@role.Id">@role.Name</option>
                                        }
                                    </select>
                                </label>

                                @if (_rolesError is not null)
                                {
                                    <p class="users-error" role="alert">@_rolesError</p>
                                }
                                @if (_modalError is not null)
                                {
                                    <p class="users-error" role="alert">@_modalError</p>
                                }

                                <div class="users-form-actions">
                                    <button class="users-button users-button--primary"
                                            type="submit"
                                            disabled="@(_saving || _roles.Count == 0)">
                                        @(_saving ? "Saving…" : "Change role")
                                    </button>
                                    <button class="users-button"
                                            type="button"
                                            disabled="@_saving"
                                            @onclick="CloseModals">Cancel</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
        </section>
    </ChildContent>
    <NotAuthorized>
        <section class="users-state" role="alert">
            <h1>You don’t have permission to view users</h1>
            <p>Your account does not have users.view permission.</p>
        </section>
    </NotAuthorized>
</RequirePermission>

@code {
    private const int PageSize = 20;
    private int _page = 1;
    private Paged<PortalUserDto>? _users;
    private bool _loading = true;
    private bool _forbidden;
    private string? _loadError;
    private bool _showCreateUserModal;
    private bool _showUpdateModal;
    private bool _showSetRoleModal;
    private Guid? _editingUserId;
    private string _newUserName = string.Empty;
    private string _newEmail = string.Empty;
    private string _newDisplayName = string.Empty;
    private string _newPassword = string.Empty;
    private Guid _newRoleId;
    private string _updateUserName = string.Empty;
    private string _updateEmail = string.Empty;
    private string _updateDisplayName = string.Empty;
    private Guid _selectedRoleId;
    private string _roleUserName = string.Empty;
    private List<RoleDto> _roles = [];
    private string? _rolesError;
    private string? _modalError;
    private string? _actionError;
    private bool _saving;
    private Guid? _toggleUserId;

    private int PageCount =>
        _users is null ? 1 : Math.Max(1, (int)Math.Ceiling((double)_users.Total / PageSize));

    protected override async Task OnInitializedAsync()
    {
        if (Session.HasPermission(Permissions.UsersView))
        {
            await LoadUsersAsync();
        }
        else
        {
            _loading = false;
        }

        if (Session.HasPermission(Permissions.UsersManage))
        {
            await LoadRolesAsync();
        }
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            _roles = await Client.GetRolesAsync();
            _rolesError = null;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or
                JsonException or
                InvalidDataException or
                TaskCanceledException)
        {
            _rolesError = "Could not load roles. Reopen the form to try again.";
        }
    }

    private async Task LoadUsersAsync()
    {
        _loading = true;
        _forbidden = false;
        _loadError = null;

        try
        {
            _users = await Client.GetUsersAsync(_page, PageSize);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or
                JsonException or
                InvalidDataException or
                TaskCanceledException)
        {
            _loadError = "Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ChangePage(int page)
    {
        _page = page;
        return LoadUsersAsync();
    }

    private Task PreviousPageAsync() => ChangePage(_page - 1);
    private Task NextPageAsync() => ChangePage(_page + 1);

    private async Task OpenCreateUserModal()
    {
        if (_roles.Count == 0 && _rolesError is not null)
        {
            await LoadRolesAsync();
        }

        _showCreateUserModal = true;
        _showUpdateModal = false;
        _showSetRoleModal = false;
        _newUserName = string.Empty;
        _newEmail = string.Empty;
        _newDisplayName = string.Empty;
        _newPassword = string.Empty;
        _newRoleId = Guid.Empty;
        _modalError = null;
    }

    private void CloseModals()
    {
        _showCreateUserModal = false;
        _showUpdateModal = false;
        _showSetRoleModal = false;
        _editingUserId = null;
        _modalError = null;
    }

    private void OpenUpdateModal(PortalUserDto user)
    {
        _editingUserId = user.Id;
        _showCreateUserModal = false;
        _showUpdateModal = true;
        _showSetRoleModal = false;
        _updateUserName = user.UserName;
        _updateEmail = user.Email;
        _updateDisplayName = user.DisplayName;
        _modalError = null;
    }

    private async Task OpenSetRoleModal(PortalUserDto user)
    {
        if (_roles.Count == 0 && _rolesError is not null)
        {
            await LoadRolesAsync();
        }

        _editingUserId = user.Id;
        _showCreateUserModal = false;
        _showUpdateModal = false;
        _showSetRoleModal = true;
        _roleUserName = $"{user.DisplayName} ({user.UserName})";
        _selectedRoleId = user.Role.Id;
        _modalError = null;
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_newUserName) ||
            string.IsNullOrWhiteSpace(_newEmail) ||
            string.IsNullOrWhiteSpace(_newDisplayName) ||
            string.IsNullOrWhiteSpace(_newPassword))
        {
            _modalError = "Complete all fields.";
            return;
        }

        if (_newRoleId == Guid.Empty)
        {
            _modalError = "Select a role.";
            return;
        }

        _saving = true;
        _modalError = null;

        try
        {
            await Client.CreateUserAsync(new CreateUserRequest(
                _newUserName.Trim(),
                _newEmail.Trim(),
                _newDisplayName.Trim(),
                _newPassword,
                _newRoleId));
            CloseModals();
            await LoadUsersAsync();
        }
        catch (HttpRequestException exception)
        {
            _modalError = FriendlyError(exception);
        }
        catch (Exception)
        {
            _modalError = "Could not create the user. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UpdateUserAsync()
    {
        if (_editingUserId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_updateEmail) ||
            string.IsNullOrWhiteSpace(_updateDisplayName))
        {
            _modalError = "Enter an email and display name.";
            return;
        }

        _saving = true;
        _modalError = null;

        try
        {
            await Client.UpdateUserAsync(_editingUserId.Value, new UpdateUserRequest(
                _updateEmail.Trim(),
                _updateDisplayName.Trim()));
            CloseModals();
            await LoadUsersAsync();
        }
        catch (HttpRequestException exception)
        {
            _modalError = FriendlyError(exception);
        }
        catch (Exception)
        {
            _modalError = "Could not save the user. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SetUserRoleAsync()
    {
        if (_editingUserId is null)
        {
            return;
        }

        if (_selectedRoleId == Guid.Empty)
        {
            _modalError = "Select a role.";
            return;
        }

        _saving = true;
        _modalError = null;

        try
        {
            await Client.SetUserRoleAsync(_editingUserId.Value, _selectedRoleId);
            CloseModals();
            await LoadUsersAsync();
        }
        catch (HttpRequestException exception)
        {
            _modalError = FriendlyError(exception);
        }
        catch (Exception)
        {
            _modalError = "Could not change the role. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleUserStatusAsync(PortalUserDto user)
    {
        _toggleUserId = user.Id;
        _actionError = null;

        try
        {
            if (user.IsActive)
            {
                await Client.DisableUserAsync(user.Id);
            }
            else
            {
                await Client.EnableUserAsync(user.Id);
            }

            await LoadUsersAsync();
        }
        catch (HttpRequestException exception)
        {
            _actionError = FriendlyError(exception);
        }
        catch (Exception)
        {
            _actionError = "Could not change the user status. Check your connection and try again.";
        }
        finally
        {
            _toggleUserId = null;
        }
    }

    private static string FriendlyError(HttpRequestException exception) =>
        exception.Message switch
        {
            "UserName already in use" => "That username is already in use.",
            "Email already in use" => "That email is already in use.",
            "The last active Administrator cannot be disabled" =>
                "The last active Administrator cannot be disabled.",
            "The last active Administrator cannot be moved to another role" =>
                "The last active Administrator cannot be moved to another role.",
            "You cannot move yourself to a role without users.manage and roles.manage" =>
                "You cannot move yourself to a role without users.manage and roles.manage.",
            _ => exception.Message
        };
}
