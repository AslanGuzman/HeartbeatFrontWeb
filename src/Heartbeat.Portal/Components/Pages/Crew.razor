@page "/"
@page "/crew"
@using System.Net
@using System.Text.Json
@inject MissionControlClient Client
@inject MissionControlSession Session

<PageTitle>Heartbeat | Crew</PageTitle>

<RequirePermission Permission="@Permissions.CrewView">
    <ChildContent>
        <section class="crew-dashboard" aria-labelledby="crew-title">
            <header class="crew-heading">
                <div>
                    <h1 id="crew-title">Crew</h1>
                    <p>Health status and activity for each astronaut.</p>
                </div>
                @if (!_loading && !_forbidden && _error is null)
                {
                    <span class="crew-count">@CrewCountLabel</span>
                }
            </header>

            @if (_loading)
            {
                <div class="crew-state" role="status" aria-busy="true">
                    <span class="session-spinner" aria-hidden="true"></span>
                    <span>Loading crew…</span>
                </div>
            }
            else if (_forbidden)
            {
                <div class="crew-state" role="alert">
                    <h2>You don’t have permission to view the crew</h2>
                    <p>Your account does not have the required permission.</p>
                </div>
            }
            else if (_error is not null)
            {
                <div class="crew-state" role="alert">
                    <h2>Could not load crew</h2>
                    <p>@_error</p>
                    <button class="crew-retry" type="button" @onclick="LoadCrewAsync">Retry</button>
                </div>
            }
            else
            {
                <section class="crew-summary" aria-label="Crew summary">
                    <div>
                        <span>Astronauts</span>
                        <strong>@_crew.Length</strong>
                    </div>
                    <div>
                        <span>Alerts abiertas</span>
                        <strong>@OpenAlertCount</strong>
                    </div>
                    <div>
                        <span>Messages sin leer</span>
                        <strong>@UnreadMessageCount</strong>
                    </div>
                </section>

                @if (_crew.Length == 0)
                {
                    <div class="crew-state crew-empty">
                        <h2>No astronauts found</h2>
                        <p>Crew members will appear here when accounts are added.</p>
                    </div>
                }
                else
                {
                    <section class="crew-roster" aria-labelledby="crew-roster-title">
                        <header class="crew-roster-heading">
                            <h2 id="crew-roster-title">Individual status</h2>
                            <p>Select a card to open the profile.</p>
                        </header>

                        <div class="crew-grid">
                            @foreach (var astronaut in _crew)
                            {
                                <a @key="astronaut.AstronautId"
                                   class="crew-card crew-card--@StatusKey(astronaut.OverallStatus)"
                                   href="@($"/crew/{astronaut.AstronautId:D}")"
                                   aria-label="@($"Open profile for {astronaut.DisplayName}")">
                                    <div class="crew-card-heading">
                                        <span class="crew-avatar" aria-hidden="true">@Initial(astronaut.DisplayName)</span>
                                        <span class="crew-identity">
                                            <strong>@astronaut.DisplayName</strong>
                                            <span>@(astronaut.CallSign ?? "No call sign")</span>
                                        </span>
                                        <span class="crew-status crew-status--@StatusKey(astronaut.OverallStatus)">
                                            <span aria-hidden="true"></span>
                                            @StatusLabel(astronaut.OverallStatus)
                                        </span>
                                    </div>

                                    <dl class="crew-metrics">
                                        <div>
                                            <dt>Last checkup</dt>
                                            <dd>@FormatTimestamp(astronaut.LastCheckUpAt)</dd>
                                        </div>
                                        <div>
                                            <dt>Last sync</dt>
                                            <dd>@FormatTimestamp(astronaut.LastSyncAt)</dd>
                                        </div>
                                        <div>
                                            <dt>Alerts abiertas</dt>
                                            <dd>@astronaut.OpenAlerts</dd>
                                        </div>
                                        <div>
                                            <dt>Messages sin leer</dt>
                                            <dd>@astronaut.UnreadMessages</dd>
                                        </div>
                                    </dl>

                                    <span class="crew-card-action">View details</span>
                                </a>
                            }
                        </div>
                    </section>
                }
            }
        </section>
    </ChildContent>
    <NotAuthorized>
        <div class="crew-state" role="alert">
            <h2>You don’t have permission to view the crew</h2>
            <p>Your account does not have the required permission.</p>
        </div>
    </NotAuthorized>
</RequirePermission>

@code {
    private CrewSummaryDto[] _crew = [];
    private bool _loading = true;
    private bool _forbidden;
    private string? _error;

    private string CrewCountLabel => $"{_crew.Length} {(_crew.Length == 1 ? "astronauta" : "astronautas")}";
    private int OpenAlertCount => _crew.Sum(astronaut => astronaut.OpenAlerts);
    private int UnreadMessageCount => _crew.Sum(astronaut => astronaut.UnreadMessages);

    protected override async Task OnInitializedAsync()
    {
        if (Session.HasPermission(Permissions.CrewView))
        {
            await LoadCrewAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadCrewAsync()
    {
        _loading = true;
        _forbidden = false;
        _error = null;

        try
        {
            _crew = await Client.GetCrewAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or
                JsonException or
                InvalidDataException or
                TaskCanceledException)
        {
            _error = "Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string StatusKey(HealthStatus? status) => status switch
    {
        HealthStatus.Normal => "normal",
        HealthStatus.Watch => "watch",
        HealthStatus.Critical => "critical",
        _ => "unknown"
    };

    private static string StatusLabel(HealthStatus? status) => status switch
    {
        HealthStatus.Normal => "Normal",
        HealthStatus.Watch => "Watch",
        HealthStatus.Critical => "Critical",
        _ => "No readings"
    };

    private static string Initial(string displayName) =>
        string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[0].ToString().ToUpperInvariant();

    private static string FormatTimestamp(DateTimeOffset? timestamp) =>
        timestamp?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "No record";
}
