@page "/roles"
@using System.Net
@using System.Text.Json
@using Heartbeat.Shared
@inject MissionControlClient Client
@inject MissionControlSession Session

<PageTitle>Heartbeat | Roles & permissions</PageTitle>

<RequirePermission Permission="@Permissions.RolesManage">
    <ChildContent>
        <section class="roles-page" aria-labelledby="roles-title">
            <header class="roles-heading">
                <div>
                    <h1 id="roles-title">Roles & permissions</h1>
                    <p>Define what each portal account type can do.</p>
                </div>
                @if (!_loading && !_forbidden && _error is null)
                {
                    <button class="roles-button roles-button--primary"
                            type="button"
                            @onclick="OpenCreateEditor">Create role</button>
                }
            </header>

            @if (_loading)
            {
                <div class="roles-state" role="status" aria-busy="true">
                    <span class="session-spinner" aria-hidden="true"></span>
                    <span>Loading roles…</span>
                </div>
            }
            else if (_forbidden)
            {
                <div class="roles-state" role="alert">
                    <h2>You don’t have permission to manage roles</h2>
                    <p>Your account does not have roles.manage permission.</p>
                </div>
            }
            else if (_error is not null)
            {
                <div class="roles-state" role="alert">
                    <h2>Could not load roles</h2>
                    <p>@_error</p>
                    <button class="roles-button" type="button" @onclick="LoadAsync">Retry</button>
                </div>
            }
            else
            {
                @if (_editorOpen)
                {
                    <form class="role-editor" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                        <h2>@(_editingRoleId is null ? "Nuevo rol" : "Edit rol")</h2>

                        <label class="role-editor-name">
                            <span>Name</span>
                            <input @bind="_editorName"
                                   maxlength="50"
                                   required
                                   disabled="@_saving" />
                        </label>

                        @if (IsEditingOwnRole)
                        {
                            <p class="role-editor-hint">
                                You cannot remove <code>users.manage</code> or
                                <code>roles.manage</code> from your own role.
                            </p>
                        }

                        <div class="permission-groups">
                            @foreach (var group in _permissions.GroupBy(p => p.Group))
                            {
                                <fieldset class="permission-group">
                                    <legend>@group.Key</legend>
                                    @foreach (var permission in group)
                                    {
                                        <label class="permission-check">
                                            <input type="checkbox"
                                                   checked="@_selected.Contains(permission.Key)"
                                                   disabled="@(_saving || IsSelfProtected(permission.Key))"
                                                   @onchange="e => TogglePermission(permission.Key, Convert.ToBoolean(e.Value))" />
                                            <span class="permission-description">@permission.Description</span>
                                            <code class="permission-key">@permission.Key</code>
                                        </label>
                                    }
                                </fieldset>
                            }
                        </div>

                        @if (_saveError is not null)
                        {
                            <p class="roles-error" role="alert">@_saveError</p>
                        }

                        <div class="role-editor-actions">
                            <button class="roles-button roles-button--primary"
                                    type="submit"
                                    disabled="@(_saving || string.IsNullOrWhiteSpace(_editorName))">
                                @(_saving ? "Saving…" : "Save")
                            </button>
                            <button class="roles-button"
                                    type="button"
                                    disabled="@_saving"
                                    @onclick="CloseEditor">Cancel</button>
                        </div>
                    </form>
                }

                @if (_actionError is not null)
                {
                    <p class="roles-error" role="alert">@_actionError</p>
                }

                @if (_roles.Count == 0)
                {
                    <div class="roles-state roles-empty">
                        <h2>No roles defined</h2>
                        <p>Create the first role using the button above.</p>
                    </div>
                }
                else
                {
                    <div class="roles-list">
                        @foreach (var role in _roles)
                        {
                            <article @key="role.Id" class="role-card">
                                <header class="role-card-heading">
                                    <div>
                                        <h2>@role.Name</h2>
                                        <p>@UserCountLabel(role.UserCount)</p>
                                    </div>
                                    @if (role.IsSystem)
                                    {
                                        <span class="role-badge">System role</span>
                                    }
                                </header>

                                @if (role.Permissions.Count == 0)
                                {
                                    <p class="role-no-permissions">No permissions assigned.</p>
                                }
                                else
                                {
                                    <ul class="role-permissions" aria-label="Permissions for @role.Name">
                                        @foreach (var permission in role.Permissions)
                                        {
                                            <li @key="permission">@permission</li>
                                        }
                                    </ul>
                                }

                                <div class="role-actions">
                                    <button class="roles-action"
                                            type="button"
                                            disabled="@(_saving || role.Name == RoleNames.Administrator)"
                                            @onclick="() => OpenEditEditor(role)">Edit</button>
                                    @if (!role.IsSystem && role.UserCount == 0)
                                    {
                                        <button class="roles-action roles-action--danger"
                                                type="button"
                                                disabled="@_saving"
                                                @onclick="() => DeleteAsync(role)">Delete</button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </section>
    </ChildContent>
</RequirePermission>

@code {
    private List<RoleDto> _roles = [];
    private IReadOnlyList<PermissionDto> _permissions = [];
    private bool _loading = true;
    private bool _forbidden;
    private string? _error;
    private bool _editorOpen;
    private bool _saving;
    private Guid? _editingRoleId;
    private string _editorName = string.Empty;
    private HashSet<string> _selected = new(StringComparer.Ordinal);
    private string? _saveError;
    private string? _actionError;

    private bool IsEditingOwnRole =>
        _editingRoleId is not null && Session.User?.Role.Id == _editingRoleId;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.HasPermission(Permissions.RolesManage))
        {
            _forbidden = true;
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _forbidden = false;
        _error = null;

        try
        {
            var rolesTask = Client.GetRolesAsync();
            var permissionsTask = Client.GetPermissionsAsync();
            await Task.WhenAll(rolesTask, permissionsTask);
            _roles = await rolesTask;
            _permissions = await permissionsTask;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (Exception exception) when (
            exception is HttpRequestException or
                JsonException or
                InvalidDataException or
                TaskCanceledException)
        {
            _error = "Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateEditor()
    {
        _editorOpen = true;
        _editingRoleId = null;
        _editorName = string.Empty;
        _selected = new HashSet<string>(StringComparer.Ordinal);
        _saveError = null;
        _actionError = null;
    }

    private void OpenEditEditor(RoleDto role)
    {
        _editorOpen = true;
        _editingRoleId = role.Id;
        _editorName = role.Name;
        _selected = new HashSet<string>(role.Permissions, StringComparer.Ordinal);
        _saveError = null;
        _actionError = null;
    }

    private void CloseEditor()
    {
        _editorOpen = false;
        _editingRoleId = null;
        _saveError = null;
    }

    private void TogglePermission(string key, bool isChecked)
    {
        if (isChecked)
        {
            _selected.Add(key);
        }
        else
        {
            _selected.Remove(key);
        }
    }

    private bool IsSelfProtected(string key) =>
        IsEditingOwnRole &&
        _selected.Contains(key) &&
        (key == Permissions.UsersManage || key == Permissions.RolesManage);

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editorName))
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            var permissions = _selected.Order(StringComparer.Ordinal).ToList();
            if (_editingRoleId is null)
            {
                await Client.CreateRoleAsync(_editorName.Trim(), permissions);
            }
            else
            {
                await Client.UpdateRoleAsync(_editingRoleId.Value, _editorName.Trim(), permissions);
            }

            _editorOpen = false;
            _editingRoleId = null;
            await LoadAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            _saveError = "The server rejected the change. Check that the name is unique, " +
                         "that you keep users.manage/roles.manage on your own role and that the role " +
                         "is not the Administrator.";
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _saveError = "Your account does not have roles.manage permission.";
        }
        catch (Exception)
        {
            _saveError = "Could not save the role. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(RoleDto role)
    {
        _saving = true;
        _actionError = null;

        try
        {
            await Client.DeleteRoleAsync(role.Id);
            await LoadAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Conflict)
        {
            _actionError = "Cannot delete this role: it is a system role or still has users assigned.";
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _actionError = "Your account does not have roles.manage permission.";
        }
        catch (Exception)
        {
            _actionError = "Could not delete the role. Check your connection and try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string UserCountLabel(int userCount) =>
        userCount == 1 ? "1 user" : $"{userCount} users";
}
