@implements IDisposable
@inject MissionControlSession Session
@inject AlertCounterState AlertCounter
@inject IStringLocalizer<SharedResource> T

<nav class="primary-navigation" aria-label="@T["Main navigation"]">
    <ul>
        <li>
            <RequirePermission Permission="@Permissions.CrewView">
                <NavLink href="/mission" Match="NavLinkMatch.Prefix">@T["Mission"]</NavLink>
            </RequirePermission>
        </li>
        <li>
            <NavLink href="/phantoms" Match="NavLinkMatch.Prefix">@T["Phantoms"]</NavLink>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.CrewView">
                <NavLink href="/crew" Match="NavLinkMatch.Prefix">@T["Crew"]</NavLink>
            </RequirePermission>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.VitalsHistory">
                <NavLink href="/charts" Match="NavLinkMatch.Prefix">@T["Trends"]</NavLink>
            </RequirePermission>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.CrewView">
                <NavLink href="/fc-en-vivo" Match="NavLinkMatch.Prefix">@T["Live heart rate"]</NavLink>
            </RequirePermission>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.CrewView">
                <NavLink href="/salud" Match="NavLinkMatch.Prefix">@T["Health summary"]</NavLink>
            </RequirePermission>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.AlertsView">
                <NavLink href="/alerts" Match="NavLinkMatch.Prefix">
                    <span>@T["Alerts"]</span>
                    @if (AlertCounter.OpenCount is > 0)
                    {
                        <span class="nav-alert-count"
                              aria-label="@($"{AlertCounter.OpenCount} {T["open alerts"]}")">
                            @AlertCounter.OpenCount
                        </span>
                    }
                </NavLink>
            </RequirePermission>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.MessagesView">
                <NavLink href="/messages" Match="NavLinkMatch.Prefix">@T["Messages"]</NavLink>
            </RequirePermission>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.UsersView">
                <NavLink href="/users" Match="NavLinkMatch.Prefix">@T["Users"]</NavLink>
            </RequirePermission>
        </li>
        <li>
            <RequirePermission Permission="@Permissions.RolesManage">
                <NavLink href="/roles" Match="NavLinkMatch.Prefix">@T["Roles & permissions"]</NavLink>
            </RequirePermission>
        </li>
    </ul>
</nav>

@code {
    protected override void OnInitialized()
    {
        AlertCounter.Changed += OnAlertCounterChanged;
        if (Session.HasPermission(Permissions.AlertsView))
        {
            _ = AlertCounter.RefreshAsync();
        }
    }

    private void OnAlertCounterChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AlertCounter.Changed -= OnAlertCounterChanged;
    }
}
