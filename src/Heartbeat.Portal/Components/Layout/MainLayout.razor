@inherits LayoutComponentBase
@implements IDisposable
@inject MissionControlSession Session
@inject MissionControlAuthentication Authentication
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T

@if (_ready && Session.User is { IsActive: true } user)
{
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="/" aria-label="@T["Heartbeat, Mission Control home"]">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 21s-8.7-5.3-10.5-10.2C-.2 3.6 7.1.2 12 6.1 16.9.2 24.2 3.6 22.5 10.8 20.7 15.7 12 21 12 21Z" />
                    </svg>
                </span>
            </a>

            <NavMenu />

            <div class="rail-footer">
                <button class="rail-item rail-item--danger" type="button"
                        @onclick="LogoutAsync" disabled="@_loggingOut"
                        title="@T["Sign out"]">
                    <span class="rail-chip" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <path d="m16 17 5-5-5-5" />
                            <path d="M21 12H9" />
                        </svg>
                    </span>
                    <span class="rail-label">@T["Exit"]</span>
                </button>
            </div>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-actions">
                    <LanguageSelector />
                    <span class="user-pill" title="@user.DisplayName">
                        <span class="user-pill-avatar" aria-hidden="true">@Initial(user.DisplayName)</span>
                        <span class="user-pill-name">@user.DisplayName</span>
                    </span>
                </div>
            </header>

            <main class="main-content">
                @Body
            </main>

            <footer class="app-footer">
                <span>Heartbeat · @T["Mission Control portal"]</span>
                <span class="app-footer-disclaimer">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 16v-4M12 8h.01" />
                    </svg>
                    @T["Monitoring prototype — not a substitute for a real medical diagnosis"]
                </span>
            </footer>
        </div>

        <div id="blazor-error-ui" data-nosnippet>
            @T["An unexpected error occurred."]
            <a href="." class="reload">@T["Reload"]</a>
            <span class="dismiss">@T["Close"]</span>
        </div>
    </div>
}
else
{
    <main class="session-check" aria-live="polite" aria-busy="@(!_ready)">
        <span class="session-spinner" aria-hidden="true"></span>
        <span>@T["Checking session…"]</span>
    </main>
}

@code {
    private bool _ready;
    private bool _loggingOut;
    private bool _restoreFailed;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await Authentication.RestoreAsync();
        }
        catch (Exception exception) when (
            exception is HttpRequestException or
                Microsoft.JSInterop.JSException or
                InvalidDataException or
                System.Text.Json.JsonException or
                TaskCanceledException)
        {
            _restoreFailed = true;
        }
        finally
        {
            _ready = true;
            StateHasChanged();
        }

        if (Session.User is null)
        {
            var expired = _restoreFailed
                ? "?connection=true"
                : Session.SessionExpired ? "?expired=true" : string.Empty;
            Navigation.NavigateTo($"/login{expired}", replace: true);
        }
    }

    private async Task LogoutAsync()
    {
        _loggingOut = true;
        await Authentication.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true, replace: true);
    }

    private static string Initial(string displayName) =>
        string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[0].ToString().ToUpperInvariant();

    private void OnSessionChanged()
    {
        _ = InvokeAsync(() =>
        {
            StateHasChanged();
            if (_ready && !_loggingOut && Session.User is null)
            {
                var expired = Session.SessionExpired ? "?expired=true" : string.Empty;
                Navigation.NavigateTo($"/login{expired}", replace: true);
            }
        });
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
