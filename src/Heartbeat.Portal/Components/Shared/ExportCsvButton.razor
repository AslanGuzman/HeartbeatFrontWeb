@implements IAsyncDisposable
@using System.Net
@using System.Text.Json
@inject MissionControlClient Client
@inject MissionControlSession Session
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> T

@if (Session.HasPermission(Permissions.VitalsHistory))
{
    <div class="export-csv">
        <button class="export-csv-button" type="button" disabled="@_busy" @onclick="ExportAsync">
            @(_busy ? T["Exporting…"] : T["Export CSV"])
        </button>
        <small>@T["Simulated data. Not a medical diagnosis."]</small>
        @if (_error is not null)
        {
            <span class="export-csv-error" role="alert">@_error</span>
        }
    </div>
}

@code {
    // Exactly one of the two: an astronaut report, or the whole mission.
    [Parameter] public Guid? AstronautId { get; set; }
    [Parameter] public Guid? MissionId { get; set; }

    private IJSObjectReference? _module;
    private bool _busy;
    private string? _error;

    private async Task ExportAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var report = AstronautId is { } id
                ? await Client.ExportAstronautCsvAsync(id)
                : await Client.ExportMissionCsvAsync(MissionId);
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./download.js");
            using var stream = new MemoryStream(report.Content);
            using var reference = new DotNetStreamReference(stream);
            await _module.InvokeVoidAsync("saveFile", report.FileName, reference);
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            _error = T["You do not have permission to export reports."];
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            _error = T["The report was not found."];
        }
        catch (Exception exception) when (
            exception is HttpRequestException or JsonException or TaskCanceledException or JSException)
        {
            _error = T["Could not download the report. Try again."];
        }
        finally
        {
            _busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
