@inject Microsoft.JSInterop.IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

<label class="language-selector">
    <span class="visually-hidden">@T["Language"]</span>
    <select aria-label="@T["Language"]" value="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" @onchange="ChangeLanguageAsync">
        <option value="es">Español</option>
        <option value="en">English</option>
    </select>
</label>

@code {
    private async Task ChangeLanguageAsync(ChangeEventArgs args)
    {
        if (args.Value is not string culture || culture is not ("es" or "en"))
            return;

        await JS.InvokeVoidAsync("heartbeatLanguage.set", culture);
    }
}
