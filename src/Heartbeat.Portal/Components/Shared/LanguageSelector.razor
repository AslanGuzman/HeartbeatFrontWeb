@inject Microsoft.JSInterop.IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> T

<div class="language-selector" role="group" aria-label="@T["Language"]">
    <button type="button" lang="es" aria-label="Español"
            aria-pressed="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es" ? "true" : "false")"
            @onclick='() => ChangeLanguageAsync("es")'>ES</button>
    <button type="button" lang="en" aria-label="English"
            aria-pressed="@(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "true" : "false")"
            @onclick='() => ChangeLanguageAsync("en")'>EN</button>
</div>

@code {
    private async Task ChangeLanguageAsync(string culture)
    {
        if (culture is not ("es" or "en") || culture == CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)
            return;

        await JS.InvokeVoidAsync("heartbeatLanguage.set", culture);
    }
}
